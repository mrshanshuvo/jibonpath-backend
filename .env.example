# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
DOCS_URL=https://documenter.getpostman.com/view/47434753/2sBYAvwWcJ

# PostgreSQL Database (Neon.tech / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/ambulance_db?sslmode=require

# JWT Authentication
JWT_SECRET=super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth 2.0 (GCP Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# bKash Tokenized Checkout (Sandbox)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# SSLCommerz Payment Gateway (Sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SESSION_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# Cloudinary File/Image Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Cache (Redis Cloud)
REDIS_URL=redis://default:password@host:port
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=default
REDIS_PASSWORD=
